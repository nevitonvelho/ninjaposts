# Copie para `.env` e preencha. `.env` está no .gitignore — nunca commite segredos.

# --- Cliente (público, exposto no bundle) -----------------------------------
# Estes valores são públicos por natureza: a segurança do Firebase vem das
# Security Rules e do App Check, não de esconder a apiKey.
NUXT_PUBLIC_APP_URL=http://localhost:3000
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
NUXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Use os emuladores locais em vez do projeto real durante o desenvolvimento.
NUXT_PUBLIC_USE_EMULATORS=true

# --- Servidor (privado) -----------------------------------------------------
# A chave da OpenAI NÃO vive aqui: quem chama a API é o worker (Cloud Function),
# e ele lê do Secret Manager. Configure com:
#   npx firebase functions:secrets:set OPENAI_API_KEY
# Para trocar de modelo, use os parâmetros OPENAI_BRIEF_MODEL / OPENAI_IMAGE_MODEL
# das Functions — não variáveis do app.

# Credenciais da service account do Admin SDK.
# Em produção no Firebase, deixe vazio: as credenciais são resolvidas
# automaticamente pelo ambiente (Application Default Credentials).
NUXT_FIREBASE_PROJECT_ID=
NUXT_FIREBASE_CLIENT_EMAIL=
NUXT_FIREBASE_PRIVATE_KEY=
NUXT_FIREBASE_STORAGE_BUCKET=

# --- Pagamento (Kiwify) -----------------------------------------------------
# `mock` permite desenvolver e testar o creditamento sem gateway.
NUXT_PAYMENT_PROVIDER=mock

# Token do webhook da Kiwify — usado para validar a assinatura de cada evento.
# Sem ele, qualquer um poderia postar uma "compra" e se creditar sozinho.
NUXT_KIWIFY_WEBHOOK_TOKEN=

# Ids dos produtos na Kiwify, por pacote. Opcional: sem eles, o pacote é
# resolvido pelo valor pago. Preencher torna o creditamento à prova de mudança
# de preço.
NUXT_KIWIFY_PRODUCT_STARTER=
NUXT_KIWIFY_PRODUCT_ESSENCIAL=
NUXT_KIWIFY_PRODUCT_PRO=
